<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<VBox spacing="15" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.uam.edu.evaluacion2.controller.RegistroController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>
    <Label text="Registro de Cliente">
        <font><Font size="20.0" /></font>
    </Label>
    <Separator />
    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" minWidth="130" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="200" />
            <ColumnConstraints halignment="RIGHT" minWidth="130" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="200" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
        </rowConstraints>

        <Label text="Nombres:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="txtNombres" GridPane.columnIndex="1" GridPane.rowIndex="0" />
        <Label text="Apellidos:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
        <TextField fx:id="txtApellidos" GridPane.columnIndex="3" GridPane.rowIndex="0" />

        <Label text="Tipo de Cliente:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <ComboBox fx:id="cmbTipoCliente" promptText="Seleccione..." GridPane.columnIndex="1" GridPane.rowIndex="1" />
        <Label text="Ciudad:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
        <ComboBox fx:id="cmbCiudad" promptText="Seleccione..." GridPane.columnIndex="3" GridPane.rowIndex="1" />

        <Label text="Fecha Nacimiento:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <DatePicker fx:id="dpFechaNac" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="Tipo de Solicitud:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <HBox spacing="15" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="3">
            <RadioButton fx:id="rbNueva" text="Nueva">
                <toggleGroup><ToggleGroup fx:id="tgSolicitud" /></toggleGroup>
            </RadioButton>
            <RadioButton fx:id="rbRenovacion" text="Renovación" toggleGroup="$tgSolicitud" />
        </HBox>

        <Label text="Servicios de Interés:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <HBox spacing="15" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="4">
            <CheckBox fx:id="chkAsesoria" text="Asesoría" />
            <CheckBox fx:id="chkSoporte" text="Soporte Técnico" />
        </HBox>
    </GridPane>

    <Separator />

    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label text="Fotografía:" />
        <ImageView fx:id="imgFoto" fitHeight="150" fitWidth="150" preserveRatio="true" />
        <Button onAction="#handleSeleccionarFoto" text="Seleccionar Imagen..." />
    </HBox>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button onAction="#handleAgregarCiudad" text="➕ Agregar Ciudad" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" />
        <Button onAction="#handleGuardar" prefWidth="100" text="Guardar" />
        <Button onAction="#handleLimpiar" prefWidth="100" text="Limpiar" />
        <Button onAction="#handleCancelar" prefWidth="100" text="Cancelar" />
    </HBox>
</VBox>
